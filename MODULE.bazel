module(
    name = "buildbuddy_validation",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_proto", version = "7.0.2")
bazel_dep(name = "protobuf", version = "29.0", repo_name = "com_google_protobuf")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.2")
use_repo(go_sdk, "go_default_sdk")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Use the released Go bindings, avoiding upstream C++/Java proto build rules.
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = [
        "gazelle:proto disable_global",
        "gazelle:go_naming_convention go_default_library",
    ],
    path = "github.com/bazelbuild/remote-apis",
)
use_repo(
    go_deps,
    "com_github_bazelbuild_remote_apis",
    "com_github_coreos_go_oidc_v3",
    "com_github_chromedp_chromedp",
    "com_github_chromedp_cdproto",
    "com_github_golang_jwt_jwt_v5",
    "com_github_google_go_cmp",
    "com_github_google_uuid",
    "com_github_gorilla_websocket",
    "com_github_jhump_protoreflect",
    "com_github_klauspost_compress",
    "com_github_redis_go_redis_v9",
    "com_github_stretchr_testify",
    "in_gopkg_yaml_v3",
    "org_golang_google_genproto",
    "org_golang_google_genproto_googleapis_api",
    "org_golang_google_genproto_googleapis_bytestream",
    "org_golang_google_genproto_googleapis_rpc",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_crypto",
    "org_golang_x_net",
    "org_golang_x_oauth2",
    "org_golang_x_sync",
)
