load("@rules_go//go:def.bzl", "go_test")

DEPS = [
    "//harness:go_default_library",
    "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:go_default_library",
    "@org_golang_google_grpc//codes:go_default_library",
    "@org_golang_google_grpc//status:go_default_library",
    "@org_golang_google_protobuf//proto:go_default_library",
]

go_test(
    name = "go_default_test",
    size = "large",
    timeout = "long",
    srcs = ["gettree_test.go", "round2_test.go"],
    tags = ["local", "requires-network"],
    deps = DEPS,
)

go_test(
    name = "bugs_test",
    size = "large",
    timeout = "long",
    srcs = ["gettree_test.go", "bugs_test.go"],
    args = ["-test.run=TestEmptyDirectories|TestPageSize|TestMissingDirectories"],
    tags = ["bug", "local", "requires-network"],
    deps = DEPS,
)
