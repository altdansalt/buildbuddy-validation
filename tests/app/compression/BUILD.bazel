load("@rules_go//go:def.bzl", "go_test")

DEPS = [
    "//harness:go_default_library",
    "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:go_default_library",
    "@com_github_stretchr_testify//require:go_default_library",
    "@org_golang_google_genproto_googleapis_bytestream//:go_default_library",
    "@org_golang_google_grpc//codes:go_default_library",
    "@org_golang_google_grpc//status:go_default_library",
]

go_test(
    name = "regression_test",
    size = "large",
    timeout = "long",
    srcs = ["compression_test.go", "helpers_test.go"],
    tags = ["local", "requires-network"],
    deps = DEPS,
)

go_test(
    name = "corrupt_batch_zstd_test",
    size = "large",
    timeout = "long",
    srcs = ["corrupt_test.go"],
    tags = ["bug", "local", "requires-network"],
    deps = DEPS,
)

go_test(
    name = "compressed_read_limit_test",
    size = "large",
    timeout = "long",
    srcs = ["helpers_test.go", "read_limit_test.go"],
    tags = ["bug", "local", "requires-network"],
    deps = DEPS,
