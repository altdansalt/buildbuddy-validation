load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "go_default_test",
    size = "large",
    timeout = "long",
    srcs = ["compression_test.go", "recording_test.go"],
    tags = [
        "local",
        "requires-network",
    ],
    deps = [
        "//harness:go_default_library",
        "@org_golang_google_genproto_googleapis_bytestream//:go_default_library",
        "@org_golang_google_grpc//:go_default_library",
        "@org_golang_google_grpc//metadata:go_default_library",
        "@org_golang_google_protobuf//proto:go_default_library",
        "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:go_default_library",
        "@com_github_stretchr_testify//require:go_default_library",
        "@org_golang_google_protobuf//types/known/durationpb:go_default_library",
    ],
)

go_test(
    name = "identity_large_input_bug_test",
    size = "large",
    timeout = "long",
    srcs = ["compression_test.go", "recording_test.go", "identity_bug_test.go"],
    args = ["-test.run=^TestIdentityOnlyLargeInput"],
    tags = ["bug", "local", "requires-network"],
    deps = [
        "//harness:go_default_library",
        "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:go_default_library",
