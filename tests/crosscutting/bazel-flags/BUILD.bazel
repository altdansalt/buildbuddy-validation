load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "go_default_test",
    args = ["-test.run=Test(RestartDuringBuild|ForcedCASEviction)"],
    size = "large",
    timeout = "long",
    srcs = ["flags_test.go"],
    tags = ["local", "requires-network"],
    deps = [
        "//harness:go_default_library",
        "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:go_default_library",
    ],
)

# Independent targets keep each replay within the runner timeout.
[go_test(
    name = "seed_%s_test" % seed,
    size = "large",
    timeout = "long",
    srcs = ["flags_test.go"],
    args = ["-flags_seed=%s" % seed, "-flags_iterations=6", "-test.run=TestRandomizedFlags"],
    tags = ["local", "requires-network"],
    deps = [
        "//harness:go_default_library",
        "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:go_default_library",
    ],
) for seed in ["83142", "20261013", "917003"]]
