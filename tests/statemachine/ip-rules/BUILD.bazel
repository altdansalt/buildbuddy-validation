load("@rules_go//go:def.bzl", "go_test")
_DEPS = [
 "@org_golang_google_genproto//googleapis/devtools/build/v1:go_default_library",
 "@org_golang_google_protobuf//types/known/anypb:go_default_library",
    "//harness:go_default_library",
    "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:go_default_library",
    "@org_golang_google_grpc//:go_default_library",
    "@org_golang_google_grpc//codes:go_default_library",
    "@org_golang_google_grpc//metadata:go_default_library",
    "@org_golang_google_grpc//status:go_default_library",
    "@org_golang_google_protobuf//encoding/protowire:go_default_library",

]

go_test(
    name = "go_default_test",
    size = "large",
    timeout = "long",
    srcs = ["consistency_test.go", "olap_test.go", "cli_test.go", "invocation_test.go"],
    tags = ["local", "requires-network"],
    deps = _DEPS,
)

go_test(
    name = "default_ttl_test",
    size = "large",
    timeout = "long",
    srcs = ["consistency_test.go", "olap_test.go", "cli_test.go", "invocation_test.go"],
    args = ["-ip_rules_default_ttl"],
    tags = ["local", "requires-network"],
    deps = _DEPS,
)

go_test(
    name = "artifact_download_enforcement_bug",
    size = "large",
    timeout = "long",
    srcs = ["consistency_test.go", "olap_test.go", "cli_test.go", "invocation_test.go", "download_repro_test.go"],
    args = ["-test.run=^TestArtifactDownloadsEnforceIPRules$$"],
    tags = ["bug", "local", "requires-network"],
    deps = _DEPS,
)

go_test(
    name = "cache_download_enforcement_bug",
    size = "large",
    timeout = "long",
    srcs = ["consistency_test.go", "olap_test.go", "cli_test.go", "invocation_test.go", "download_repro_test.go"],
    args = ["-test.run=^TestArtifactDownloadsEnforceIPRules$$", "-ip_rules_signed_app"],
    tags = ["bug", "local", "requires-network"],
    deps = _DEPS,
)
